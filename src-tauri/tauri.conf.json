{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "my-tauri-app",
  "version": "0.1.0",
  "identifier": "com.jim.mytauriapp",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "my-tauri-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://localhost:3001; media-src 'self' asset: http://asset.localhost http://localhost:3001 http://127.0.0.1:*;",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
